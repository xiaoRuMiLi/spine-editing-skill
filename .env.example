# spine-forge 本地配置
# 复制为 .env 后填写。.env 不进版本库。

# ---- 皮肤部件生成服务 ----------------------------------------------
# 选哪个服务。改这一行即可换服务，不用动代码。
SPINE_SKIN_PROVIDER=qwen

# 千问（阿里云百炼 / DashScope）图生图
QIANWEN_API_KEY=
SPINE_SKIN_MODEL=qwen-image-2.1-turbo
SPINE_SKIN_BASE_URL=https://llm-l7jagaoeeeo9jsgi.cn-beijing.maas.aliyuncs.com
SPINE_SKIN_TIMEOUT=180

# ---- 提示词模板 ------------------------------------------------
# 默认读仓库里的 config/prompts.json（改词句不用动代码）。
# 需要临时换一套模板时取消注释并指向别的文件。
# SPINE_PROMPTS_FILE=config/prompts.json
